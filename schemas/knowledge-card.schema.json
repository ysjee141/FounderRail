{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "title", "module", "claim", "action", "applies_when", "does_not_apply_when", "source_ids", "roles", "verified_at", "review_after", "risk", "professional_review", "status"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "module": { "type": "string", "pattern": "^[a-z0-9-/]+$" },
    "claim": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "applies_when": { "type": "string", "minLength": 1 },
    "does_not_apply_when": { "type": "string", "minLength": 1 },
    "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "roles": { "type": "array", "minItems": 1, "items": { "enum": ["founder-office", "product-growth", "engineering", "finance-ops", "risk-quality"] } },
    "verified_at": { "type": "string", "format": "date" },
    "review_after": { "type": "string", "format": "date" },
    "risk": { "enum": ["low", "medium", "high"] },
    "professional_review": { "enum": ["never", "conditional", "required"] },
    "status": { "enum": ["draft", "verified", "rejected"] }
  }
}

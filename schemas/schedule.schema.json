{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recurring Draft Task Schedules",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "schedules"],
  "properties": {
    "version": { "const": 1 },
    "schedules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "workflow_id", "cadence", "timezone", "at", "catch_up_hours", "owner_agent", "objective", "why", "enabled"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "workflow_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "cadence": { "enum": ["weekly", "monthly"] },
          "weekday": { "type": "integer", "minimum": 1, "maximum": 7 },
          "day": { "type": "integer", "minimum": 1, "maximum": 28 },
          "timezone": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$" },
          "catch_up_hours": { "type": "integer", "minimum": 1, "maximum": 744 },
          "owner_agent": { "enum": ["founder-office", "product-growth", "engineering", "finance-ops", "risk-quality"] },
          "objective": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" }
        },
        "allOf": [
          { "if": { "properties": { "cadence": { "const": "weekly" } } }, "then": { "required": ["weekday"] } },
          { "if": { "properties": { "cadence": { "const": "monthly" } } }, "then": { "required": ["day"] } }
        ]
      }
    }
  }
}

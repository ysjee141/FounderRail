{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-team.local/schemas/approval.schema.json",
  "title": "Human Approval Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "task_id", "action", "artifact_path", "artifact_sha256", "status", "created_at", "resolved_at", "decision_reason"],
  "properties": {
    "id": { "type": "string", "pattern": "^APPROVAL-[A-Z0-9-]+$" },
    "task_id": { "type": "string", "pattern": "^TASK-[A-Z0-9-]+$" },
    "action": { "type": "string", "minLength": 1 },
    "artifact_path": { "type": "string", "minLength": 1 },
    "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["pending", "approved", "rejected", "changes_requested"] },
    "created_at": { "type": "string", "format": "date-time" },
    "resolved_at": { "type": ["string", "null"], "format": "date-time" },
    "decision_reason": { "type": ["string", "null"] }
  }
}
